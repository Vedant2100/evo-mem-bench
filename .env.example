# OpenAI-compatible worker (local vLLM or remote provider):
OPENAI_API_KEY=local
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
WORKER_MODEL=Qwen/Qwen3-32B
# Inference mode 'standard' uses the three variables above.
# For upstream ARK batch instead: WORKER_API_MODE=batch; BATCH_MODEL=deepseek-v3-2-251201
WORKER_API_MODE=standard
BATCH_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional memory-model / embedding services for A-MEM and ReasoningBank.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALFWORLD_PORT=36005
