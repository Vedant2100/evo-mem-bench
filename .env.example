# Worker: local OpenAI-compatible vLLM chat endpoint.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=local
WORKER_MODEL=Qwen/Qwen3-32B
WORKER_TEMPERATURE=0
WORKER_API_MODE=standard

# Memory writers default to the same chat model. A different local model may be used.
EVO_MEM_LLM_BASE_URL=http://127.0.0.1:8000/v1
EVO_MEM_LLM_API_KEY=local
EVO_MEM_LLM_MODEL=Qwen/Qwen3-32B

# Local OpenAI-compatible embedding endpoint (serve Qwen3-Embedding on port 8001).
DASHSCOPE_BASE_URL=http://127.0.0.1:8001/v1
DASHSCOPE_API_KEY=local
EVO_MEM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# ALFWorld server. Must be reachable from the evaluator process.
ALFWORLD_PORT=36005

# Optional evaluator settings.
# EVO_MEM_MAX_INJECT_TOKENS=2048
# MEMORY_MODEL=Qwen/Qwen3-32B
